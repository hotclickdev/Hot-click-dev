# Reusa los MISMOS valores que Hot_click_outlet/.env — no se gestiona una API key nueva.
# En producción, AiCopilotService.java manda su propio "Authorization: Bearer <NVIDIA_API_KEY>"
# en cada request — el sidecar reenvía ese mismo header a NVIDIA NIM, así que estas variables
# solo hacen falta para probar el sidecar de forma aislada con curl (sin pasar por Java).
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
