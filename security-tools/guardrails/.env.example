# Reusa los MISMOS valores que Hot_click_outlet/.env — no se gestiona una API key nueva.
# El copilot de admin ya no llama a NVIDIA; estas variables sirven para probar el
# sidecar de forma aislada con curl (sin pasar por Java) y para deepteam.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
