# ?????????????????????????????????????????????????????????????????????????????
# HOTCLICK ó Template de variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees .env con credenciales. Solo este .env.example va a git.
# ?????????????????????????????????????????????????????????????????????????????

# ?? Servidor ??????????????????????????????????????????????????????????????????
PORT=8080
APP_URL=https://hotclick.lat

# ?? Base de datos ó PostgreSQL ????????????????????????????????????????????????
# ProducciÛn actual (EC2 + RDS): host de RDS, sslmode=require
# DB_URL=jdbc:postgresql://<rds-host>:5432/postgres?sslmode=require
#
# Lightsail 4 GB (compose: docker-compose.lightsail.yml) ó Postgres en Docker:
# POSTGRES_DB=hotclick
# DB_URL=jdbc:postgresql://postgres:5432/hotclick?sslmode=disable
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=
POSTGRES_DB=hotclick

# ?? JWT ???????????????????????????????????????????????????????????????????????
# Genera con: openssl rand -base64 64
JWT_SECRET=

# ?? TOTP / 2FA (AES-256-GCM) ?????????????????????????????????????????????????
# Genera con: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ?? CORS ??????????????????????????????????????????????????????????????????????
CORS_ALLOWED_ORIGINS=https://hotclick.lat

# ?? Secreto interno (endpoints server-only) ???????????????????????????????????
# Genera con: openssl rand -base64 32
INTERNAL_SECRET=

# ?? SendGrid ó email transaccional ???????????????????????????????????????????
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=no-reply@hotclick.lat
SENDGRID_FROM_NAME=HOTCLICK

# ?? AWS S3 ó almacenamiento de im·genes ???????????????????????????????????????
AWS_S3_BUCKET=hotclick-media
AWS_S3_REGION=us-east-2
AWS_S3_PUBLIC_URL=https://hotclick-media.s3.us-east-2.amazonaws.com
# Credenciales AWS: en EC2 usa Instance Profile (dejar vacÌo).
# En Lightsail NO hay Instance Profile: descomentar un IAM user con acceso S3
# (polÌtica tipo HotclickS3Access). Nunca commitear las keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ?? Stripe ó pagos ????????????????????????????????????????????????????????????
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxx

# ?? ONVO Pay ó pagos con tarjeta (Costa Rica) ?????????????????????????????????
ONVO_SECRET_KEY=onvo_test_secret_key_xxxxxxxxxxxxxxxxxxxx
ONVO_WEBHOOK_SECRET=webhook_secret_xxxxxxxxxxxxxxxxxxxx
ONVO_PUBLISHABLE_KEY=onvo_test_publishable_key_xxxxxxxxxxxxxxxxxxxx
# N˙mero destino SINPE MÛvil de ONVO (default p˙blico de ONVO)
ONVO_SINPE_DESTINO=+50670196686
# Price IDs recurrentes (crear una vez en dashboard ONVO: product + price type=recurring)
ONVO_PRICE_ID_PYME=
ONVO_PRICE_ID_NEGOCIO_PLUS=

# Tilopay (tarjeta embebida SDK v2) ó admin.tilopay.com/admin/checkout
# Sin credenciales el backend usa mock (loginSdk + Init simulados) para desarrollo local.
TILOPAY_API_USER=
TILOPAY_PASSWORD=
TILOPAY_KEY=
TILOPAY_BASE_URL=https://app.tilopay.com
# Opcional: si se define, /api/webhooks/tilopay exige header X-Webhook-Secret
TILOPAY_WEBHOOK_SECRET=
# Checkout tienda: ONVO deshabilitado (suscripciÛn SaaS / POS pueden seguir us·ndolo)
PAYMENTS_ONVO_ENABLED=false
# ComisiÛn gateway por defecto (empresa puede override en Admin ? ConfiguraciÛn ? ComisiÛn)
# HOTCLICK_COMISION_GATEWAY_PCT=5
# true = sin ubicaciÛn de despacho (provincia, cantÛn, direcciÛn) no se aprueba el negocio ni publica productos
UBICACION_DESPACHO_OBLIGATORIA=false

# ?? Clerk ó autenticaciÛn social ??????????????????????????????????????????????
CLERK_JWKS_URI=https://<clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<clerk-domain>

# ?? Anthropic / Claude ó chat de tienda, copilot admin/Telegram, descripciones ?
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ?? NVIDIA NIM ó solo deepteam / sidecar guardrails (no es el copilot) ?????????
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Sidecar NeMo Guardrails (security-tools/guardrails/), no el panel /admin/copilot.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/

# ?? Voyage AI ó embeddings RAG ????????????????????????????????????????????????
VOYAGE_API_KEY=

# ?? Google Vision / Gemini ó an·lisis de im·genes (opcional) ?????????????????
GOOGLE_VISION_API_KEY=
GEMINI_API_KEY=

# ?? Telegram ó alertas operacionales ?????????????????????????????????????????
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ?? Telegram ó bot para clientes (Emprendedor/PyME/Negocio Plus) ?????????????
# Token y username del bot creado en BotFather (username sin @).
# El webhook secret es un string aleatorio largo (ej: openssl rand -hex 32).
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_CLIENT_WEBHOOK_SECRET=

# ?? AbuseIPDB ó reputaciÛn de IPs en logins (gratis: 1,000 req/dÌa) ??????????
# Registro en https://abuseipdb.com ? My Account ? API
ABUSEIPDB_API_KEY=

# ?? Cloudflare Turnstile ó anti-bot en login y registro ???????????????????????
# dash.cloudflare.com ? Turnstile ? Agregar sitio ? Widget type: Invisible
# Secret key del backend (nunca exponerla en el frontend)
TURNSTILE_SECRET_KEY=

# ?? Sentry ó monitoreo de errores ?????????????????????????????????????????????
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_ENVIRONMENT=production
SENTRY_WEBHOOK_SECRET=

# ?? PostHog ó captura server-side (pedido_pagado). Misma project API key. ?????
# El token p˙blico del frontend es VITE_POSTHOG_PROJECT_TOKEN (mismo project).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# ?? UptimeRobot ó webhook de disponibilidad ???????????????????????????????????
UPTIME_WEBHOOK_SECRET=

# ?? WhatsApp Business ó Meta Cloud API ???????????????????????????????????????
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ?? Twilio SMS ó aviso al telÈfono cuando cambia una cuenta de cobro ??????????
# VacÌo = no envÌa SMS (se usa WhatsApp y/o email). Nunca hardcodear las keys.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ?? GitHub ó Incident Remediation Bot ????????????????????????????????????????
GITHUB_TOKEN=
GITHUB_REPO=hotclickdev/Hot-click-dev

# ?? N8N ó automatizaciones (dejar vacÌo para deshabilitar) ???????????????????
N8N_WEBHOOK_PEDIDO_NUEVO=
N8N_WEBHOOK_PEDIDO_ENTREGADO=
N8N_WEBHOOK_CARRITO_ABANDONADO=
N8N_WEBHOOK_USUARIO_REGISTRADO=

# ?? Admin IT ó notificaciones internas ???????????????????????????????????????
ADMINIT_EMAIL=hotclick.cr@gmail.com
ADMINIT_TELEFONO=50686667888
SECURITY_ALERT_EMAIL=hotclick.cr@gmail.com
SOPORTE_TICKETS_EMAIL=hotclick.cr@gmail.com

# ?? Cuenta admin seed (admin@hotclick.com) ????????????????????????????????????
# ContraseÒa usada al CREAR el usuario admin. Para forzar un reseteo en una
# cuenta existente (recuperaciÛn), poner ADMIN_RESET_PASSWORD=true, reiniciar
# el contenedor y volver a ponerlo en false. Valor real solo en .env / EC2.
ADMIN_DEFAULT_PASSWORD=
ADMIN_RESET_PASSWORD=false

# ?? WebAuthn / FIDO2 ??????????????????????????????????????????????????????????
WEBAUTHN_RP_ID=hotclick.lat
WEBAUTHN_RP_NAME=HotClick

# ?? RAG Indexer ???????????????????????????????????????????????????????????????
RAG_INDEXER_CRON=0 0 4 * * *
RAG_INDEXER_BATCH_DELAY_MS=400

# ?? Proxies de confianza ó resoluciÛn de la IP del cliente ???????????????????
# Rangos (IP o CIDR, separados por coma) desde los que se aceptan los headers
# X-Forwarded-For / X-Real-IP. Desde cualquier otra IP se usa el peer TCP real,
# para que un header falsificado no permita evadir rate limiting ni bloqueo de IPs.
#   private ? loopback + rangos privados: funciona en EC2+Nginx y en Render.
#   vacÌo   ? no confiar en ning˙n header (app expuesta directo a Internet).
SECURITY_TRUSTED_PROXIES=private

# ?? Hashing de contraseÒas ó work factor de bcrypt ????????????????????????????
# Rango 10ñ15 (default 12). Cada +1 duplica el tiempo de verificaciÛn.
# Subirlo es retrocompatible: el cost viaja dentro del hash, los hashes viejos
# se siguen validando. Fuera de rango, el backend avisa en el log y usa 12.
BCRYPT_COST=12

# -- Meta Ads ù Pixel + Conversion API + Insights (vacùo = desactivado) -------
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# -- GA4 Measurement Protocol (purchase server-side; ID pùblico + secret) ------
GA4_MEASUREMENT_ID=
GA4_MP_API_SECRET=
