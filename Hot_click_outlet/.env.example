# ─────────────────────────────────────────────────────────────────────────────
# HOTCLICK — Template de variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees .env con credenciales. Solo este .env.example va a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8080
APP_URL=https://hotclick.lat

# ── Base de datos — PostgreSQL (AWS RDS) ──────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 64
JWT_SECRET=

# ── TOTP / 2FA (AES-256-GCM) ─────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://hotclick.lat

# ── Secreto interno (endpoints server-only) ───────────────────────────────────
# Genera con: openssl rand -base64 32
INTERNAL_SECRET=

# ── SendGrid — email transaccional ───────────────────────────────────────────
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=no-reply@hotclick.lat
SENDGRID_FROM_NAME=HOTCLICK

# ── AWS S3 — almacenamiento de imágenes ───────────────────────────────────────
AWS_S3_BUCKET=hotclick-media
AWS_S3_REGION=us-east-2
AWS_S3_PUBLIC_URL=https://hotclick-media.s3.us-east-2.amazonaws.com
# Credenciales AWS solo si NO se usa Instance Profile (EC2 usa Instance Profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Stripe — pagos ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxx

# ── ONVO Pay — pagos con tarjeta (Costa Rica) ─────────────────────────────────
ONVO_SECRET_KEY=onvo_test_secret_key_xxxxxxxxxxxxxxxxxxxx
ONVO_WEBHOOK_SECRET=webhook_secret_xxxxxxxxxxxxxxxxxxxx

# ── Clerk — autenticación social ──────────────────────────────────────────────
CLERK_JWKS_URI=https://<clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<clerk-domain>

# ── Anthropic / Claude AI — generación de descripciones, import de catálogo, RAG ─
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── NVIDIA NIM — AI Copilot (/admin/copilot) ──────────────────────────────────
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Voyage AI — embeddings RAG ────────────────────────────────────────────────
VOYAGE_API_KEY=

# ── Google Vision / Gemini — análisis de imágenes (opcional) ─────────────────
GOOGLE_VISION_API_KEY=
GEMINI_API_KEY=

# ── Telegram — alertas operacionales ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Telegram — bot para clientes (Emprendedor/PyME/Negocio Plus) ─────────────
# Token y username del bot creado en BotFather (username sin @).
# El webhook secret es un string aleatorio largo (ej: openssl rand -hex 32).
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_CLIENT_WEBHOOK_SECRET=

# ── AbuseIPDB — reputación de IPs en logins (gratis: 1,000 req/día) ──────────
# Registro en https://abuseipdb.com → My Account → API
ABUSEIPDB_API_KEY=

# ── Cloudflare Turnstile — anti-bot en login y registro ───────────────────────
# dash.cloudflare.com → Turnstile → Agregar sitio → Widget type: Invisible
# Secret key del backend (nunca exponerla en el frontend)
TURNSTILE_SECRET_KEY=

# ── Sentry — monitoreo de errores ─────────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_ENVIRONMENT=production
SENTRY_WEBHOOK_SECRET=

# ── UptimeRobot — webhook de disponibilidad ───────────────────────────────────
UPTIME_WEBHOOK_SECRET=

# ── WhatsApp Business — Meta Cloud API ───────────────────────────────────────
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ── GitHub — Incident Remediation Bot ────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=hotclickdev/Hot-click-dev

# ── N8N — automatizaciones (dejar vacío para deshabilitar) ───────────────────
N8N_WEBHOOK_PEDIDO_NUEVO=
N8N_WEBHOOK_PEDIDO_ENTREGADO=
N8N_WEBHOOK_CARRITO_ABANDONADO=
N8N_WEBHOOK_USUARIO_REGISTRADO=

# ── Admin IT — notificaciones internas ───────────────────────────────────────
ADMINIT_EMAIL=hotclick.cr@gmail.com
ADMINIT_TELEFONO=50686667888
SECURITY_ALERT_EMAIL=hotclick.cr@gmail.com

# ── WebAuthn / FIDO2 ──────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=hotclick.lat
WEBAUTHN_RP_NAME=HotClick

# ── RAG Indexer ───────────────────────────────────────────────────────────────
RAG_INDEXER_CRON=0 0 4 * * *
RAG_INDEXER_BATCH_DELAY_MS=400
