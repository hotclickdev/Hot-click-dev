# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env a Git

# Base de datos — Supabase PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://...supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.xxxxxxxxxxxx
SPRING_DATASOURCE_PASSWORD=

# Supabase Storage
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Gmail SMTP (App Password de Google)
MAIL_PASSWORD=

# URL pública de la app (cambiar en producción)
APP_URL=http://localhost:8080
