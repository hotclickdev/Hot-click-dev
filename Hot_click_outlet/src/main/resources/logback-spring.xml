<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- requestId injected by MdcRequestIdFilter; falls back to '-' when absent -->
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:--}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="CONSOLE" />
  </root>

  <logger name="com.hotclick" level="INFO" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>

  <!-- Keep Spring Security at WARN in production to avoid credential noise -->
  <logger name="org.springframework.security" level="WARN" />
  <logger name="org.springframework.web"       level="WARN" />
  <logger name="org.hibernate"                 level="WARN" />
  <logger name="com.zaxxer.hikari"             level="WARN" />

</configuration>
