# ─────────────────────────────────────────────────────────────────────────────
# HOTCLICK Frontend — Template de variables de entorno (Vite)
# Copia como .env.local para desarrollo. NUNCA commitees .env.local.
# Las variables VITE_* quedan expuestas en el bundle del navegador — solo
# poner aquí claves PÚBLICAS (publishable keys, IDs de tracking, etc.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk — autenticación social (clave pública, segura en frontend) ──────────
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY

# ── Google Analytics 4 (ID público) ──────────────────────────────────────────
VITE_GA4_ID=G-XXXXXXXXXX

# ── Sentry — monitoreo de errores en tiempo real ─────────────────────────────
VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Opcional: git sha en CI para agrupar errores por release
VITE_APP_RELEASE=

# ── PostHog — analytics de producto y session replay ─────────────────────────
VITE_POSTHOG_PROJECT_TOKEN=YOUR_POSTHOG_PROJECT_TOKEN
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Google Search Console / Bing Webmaster (metas en index.html al buildear) ─
# Pegá el token de verificación HTML (propiedad → Configuración → Verificación).
# Sitemap: https://hotclick.lat/sitemap.xml
# Merchant feed: https://hotclick.lat/api/public/feed/shopping.xml
# Vacío = no se inyecta la meta. Rebuild del frontend tras pegar el token.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# ── Microsoft Clarity — heatmaps (opcional, solo con consentimiento analytics)
VITE_CLARITY_ID=

# ── ONVO Pay — SDK embebido en pago POS QR (clave pública; opcional si el backend la devuelve)
VITE_ONVO_PUBLISHABLE_KEY=

# ── URL pública del sitio (opcional). Si el cajero usa localhost, el QR del celular
# puede apuntar aquí (ej. https://hotclick.lat). Vacío = usa el origin del navegador.
VITE_PUBLIC_APP_URL=
