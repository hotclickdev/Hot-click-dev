# ============================================================
# HotClick STAGING — copiar a .env.staging en el servidor de staging
# (chmod 600, NUNCA al git). Todos los valores son placeholders.
# Staging no comparte NADA con producción: ni base, ni llaves, ni bucket.
# ============================================================
HOTCLICK_ENV=staging
# Perfil Spring: igual a producción (nunca dev ni test).
SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_URL=https://staging.example.invalid
CORS_ALLOWED_ORIGINS=https://staging.example.invalid

# ── Base local del contenedor (solo datos de prueba) ──
POSTGRES_DB=hotclick_staging
DB_URL=jdbc:postgresql://postgres:5432/hotclick_staging?sslmode=disable
DB_USERNAME=<usuario-staging>
DB_PASSWORD=<password-staging-distinta-a-prod>

# ── Secretos propios de staging (generar nuevos, no copiar los de prod) ──
JWT_SECRET=<generar: openssl rand -base64 48>
TOTP_ENCRYPTION_KEY=<generar: openssl rand -base64 32>
INTERNAL_SECRET=<generar: openssl rand -hex 32>
HOTCLICK_ADMIN_INITIAL_PASSWORD=<password-admin-staging>

# ── ONVO: SOLO modo prueba. El deploy aborta si ve una llave live. ──
PAYMENTS_ONVO_ENABLED=false
PAYMENTS_ONVO_PERMITIR_LLAVE_TEST=true
ONVO_SECRET_KEY=onvo_test_secret_key_<placeholder>
ONVO_PUBLISHABLE_KEY=onvo_test_publishable_key_<placeholder>
ONVO_WEBHOOK_SECRET=<webhook-secret-de-prueba>

# ── Correo, IA, mensajería: vacíos = apagados en staging ──
SENDGRID_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
TWILIO_AUTH_TOKEN=

# ── Observabilidad (opcional; vacío = apagado) ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
POSTHOG_PROJECT_TOKEN=
