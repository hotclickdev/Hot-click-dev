# /etc/hotclick/backup.env  (root:hotclick-backup, chmod 640). Sin la clave privada age.
PG_CONTAINER=hotclick-postgres
PG_DB=hotclick
PG_USER=<DB_USERNAME del .env de la app>
AGE_RECIPIENT=age1<clave pública>
BACKUP_S3_URI=s3://<bucket>/postgres
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=<clave del usuario IAM hotclick-db-backup-writer>
AWS_SECRET_ACCESS_KEY=<secreto de esa clave>
MIN_BYTES=65536
# Opcional: aviso de fallo (el mismo bot que usa la app)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
