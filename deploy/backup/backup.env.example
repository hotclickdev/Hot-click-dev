# /etc/hotclick/backup.env  (root:hotclick-backup, chmod 640). Sin la clave privada age.
PG_CONTAINER=hotclick-postgres
PG_DB=hotclick
PG_USER=<DB_USERNAME del .env de la app>
AGE_RECIPIENT=age1<clave pública>
MIN_BYTES=65536
RETENTION_DAYS=35

# Google Drive: id de la carpeta que creó rclone (ver README)
GDRIVE_FOLDER_ID=<id>
# Modo OAuth (recomendado, Gmail gratis). Token = JSON de una línea que imprime `rclone authorize`.
GDRIVE_CLIENT_ID=<client id>.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=<client secret>
GDRIVE_RCLONE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'
# Modo service account (SOLO con unidad compartida de Workspace; dejar vacío el bloque OAuth):
# GDRIVE_SA_JSON_FILE=/etc/hotclick/gdrive-sa.json
# GDRIVE_SHARED_DRIVE_ID=<id de la unidad compartida>

# Opcional: aviso de fallo (el mismo bot que usa la app)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
