# ─────────────────────────────────────────────────────────────────────────────
# HOTCLICK — Plantilla de .env para la VM Oracle Always Free
# Copiar EN EL SERVIDOR como deploy/oracle/.env (junto a docker-compose.oracle.yml) y llenar ahí.
#   cp .env.oracle.example .env && chmod 600 .env
# NUNCA commitear el .env. Esta plantilla NO lleva secretos reales.
# Convención: vacío o <placeholder> = lo debe llenar Andrés en el servidor.
# Primera prueba en esta VM: ONVO SANDBOX (llaves de prueba). ONVO live requiere OK explícito de Andrés.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=8080
# URL pública con https y dominio (la app no arranca con localhost/IP en prod).
# LLENAR: dominio de prueba o definitivo (solo hotclick.lat tras el cutover DNS autorizado).
APP_URL=https://<DOMINIO>
CORS_ALLOWED_ORIGINS=https://<DOMINIO>
WEBAUTHN_RP_ID=<DOMINIO>
WEBAUTHN_RP_NAME=HotClick

# ── Base de datos (Postgres en Docker, base VACÍA, volumen nuevo) ────────────
POSTGRES_DB=hotclick
DB_URL=jdbc:postgresql://postgres:5432/hotclick?sslmode=disable
DB_USERNAME=hotclick
# LLENAR (generar: openssl rand -base64 24 | tr -d '/+=')
DB_PASSWORD=

# ── Secretos de la app (generar en el servidor; no reutilizar los de producción) ─
# openssl rand -base64 64
JWT_SECRET=
# openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
# openssl rand -base64 32
INTERNAL_SECRET=
# Contraseña inicial del admin (>=12 caracteres, 3 tipos de carácter). Solo en el servidor.
HOTCLICK_ADMIN_INITIAL_PASSWORD=
ADMIN_RESET_PASSWORD=false

# ── Almacenamiento: OCI Object Storage por API S3-compatible ─────────────────
# Si AWS_S3_ENDPOINT queda vacío la app usa AWS S3 (comportamiento por defecto).
# LLENAR <namespace> (Tenancy details / `oci os ns get`) y <bucket> tras crear el bucket (requiere OK de Andrés).
AWS_S3_ENDPOINT=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
AWS_S3_PATH_STYLE=true
AWS_S3_PUBLIC_OBJECT_ACL=false
AWS_S3_REGION=us-ashburn-1
AWS_S3_BUCKET=<bucket>
# Sin barra final.
AWS_S3_PUBLIC_URL=https://objectstorage.us-ashburn-1.oraclecloud.com/n/<namespace>/b/<bucket>/o
# Customer Secret Key de OCI (Perfil → Customer secret keys). Solo en el servidor.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# OJO: con AWS_S3_PUBLIC_OBJECT_ACL=false la lectura pública del bucket NO debe cubrir los
# prefijos privados comprobantes-sinpe/ ni certificados/ (ver .env.example del backend).

# ── ONVO Pay — SANDBOX para la primera prueba ───────────────────────────────
# Llaves de la cuenta de PRUEBA. No poner llaves live sin OK de Andrés.
ONVO_SECRET_KEY=<onvo_test_secret_key>
ONVO_WEBHOOK_SECRET=<onvo_test_webhook_secret>
ONVO_PUBLISHABLE_KEY=<onvo_test_publishable_key>
ONVO_SINPE_DESTINO=<numero-destino-onvo>
POS_SINPE_ONVO_TIMEOUT_MINUTOS=10
# Price IDs recurrentes de la cuenta de PRUEBA. PYME y NEGOCIO_PLUS son obligatorios (el compose aborta si faltan).
ONVO_PRICE_ID_EMPRENDEDOR=<price_test_emprendedor>
ONVO_PRICE_ID_PYME=<price_test_pyme>
ONVO_PRICE_ID_NEGOCIO_PLUS=<price_test_negocio_plus>
PAYMENTS_ONVO_ENABLED=false
PAYMENTS_ONVO_PERMITIR_LLAVE_TEST=false

# ── Planes y precios (obligatorios, sin default en código) ───────────────────
EMPRENDEDOR_PRECIO_MENSUAL_USD=9
PYME_PRECIO_MENSUAL_USD=24
NEGOCIO_PLUS_PRECIO_MENSUAL_USD=49
TRIAL_EMPRENDEDOR_CUPO=70
TRIAL_EMPRENDEDOR_DIAS=90
PLANES_MONEDA=USD
HOTCLICK_QA_ALTA_PYME_TEST_HABILITADO=false

# ── Correo (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@<DOMINIO>
SENDGRID_FROM_NAME=HOTCLICK

# ── Integraciones (todas opcionales; vacío = desactivada) ────────────────────
CLERK_JWKS_URI=https://<clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<clerk-domain>
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
VOYAGE_API_KEY=
TURNSTILE_SECRET_KEY=
ABUSEIPDB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=oracle-test
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# ── Seguridad ────────────────────────────────────────────────────────────────
# Nginx en el host (loopback/privado) → se confía en X-Forwarded-For solo desde rangos privados.
SECURITY_TRUSTED_PROXIES=private
BCRYPT_COST=12

# ── Notificaciones internas ──────────────────────────────────────────────────
ADMINIT_EMAIL=<correo-admin>
SECURITY_ALERT_EMAIL=<correo-seguridad>
SOPORTE_TICKETS_EMAIL=<correo-soporte>
