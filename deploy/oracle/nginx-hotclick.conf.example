# Plantilla Nginx para la VM Oracle (Nginx en el host, igual que Lightsail; no va en compose).
# Copiar a /etc/nginx/sites-available/hotclick y reemplazar <DOMINIO>:
#   - Para la primera prueba usar un subdominio o el dominio definitivo SOLO cuando Andrés autorice el cutover DNS.
#   - NO reutilizar hotclick.lat hasta que el DNS apunte a la IP de Oracle.
#
# Flujo con certbot (ver README-ORACLE.md, paso 7):
#   1. Instalar este archivo solo con el bloque :80 (el bloque :443 comentado) y recargar nginx.
#   2. sudo certbot --nginx -d <DOMINIO> -d www.<DOMINIO>   (o certonly --webroot / --nginx)
#   3. Certbot agrega/ajusta el bloque 443; o descomentar el de abajo si se usa certonly.

# Websocket (si la app lo usa)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name <DOMINIO> www.<DOMINIO>;

    # Desafío HTTP-01 de Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

