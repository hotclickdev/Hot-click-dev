# Copiar a $HOME/.config/hotclick/backup.env en el host de Lightsail (chmod 600).
# No commitear el archivo con valores. No reutilizar las keys del bucket de imágenes.
# IAM: scripts/backup/iam-backup-policy.json (reemplazar BUCKET_NAME).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db
