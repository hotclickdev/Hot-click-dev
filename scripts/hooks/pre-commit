#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# SECRET GUARD — pre-commit hook (versionado)
# Bloquea commits que incluyan archivos .env con credenciales reales o
# contenido con patrones conocidos de API keys. Si gitleaks está instalado,
# también corre su detección (~150 reglas + entropía) sobre el diff staged.
#
# El gate REAL y confiable es el job "gitleaks" en .github/workflows/security.yml
# — este hook es solo feedback rápido local, no reemplaza el chequeo de CI.
# ─────────────────────────────────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

# ─── 1. Bloquear archivos .env (salvo *.example) ─────────────────────────────
ENV_STAGED=$(git diff --cached --name-only | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -v '\.example$' || true)
if [ -n "$ENV_STAGED" ]; then
  printf "${RED}[SECRET GUARD] BLOQUEADO: Se intentaron commitear archivos .env con credenciales:${NC}\n"
  echo "$ENV_STAGED"
  printf "\nUsa .env.example para plantillas. NUNCA commitees .env, .env.local, .env.production, etc.\n\n"
  ERRORS=1
fi

# ─── 2. Escanear diff staged por patrones de API keys conocidos ──────────────
PATTERNS="sk-ant-api[0-9]|sb_secret_[A-Za-z0-9_-]{10,}|SG\.[A-Za-z0-9_-]{20,}|sk_live_[A-Za-z0-9]{20,}|sk_test_[A-Za-z0-9]{20,}|whsec_[A-Za-z0-9]{20,}|phc_[A-Za-z0-9]{20,}|pk_live_[A-Za-z0-9]{20,}"

SECRETS_FOUND=$(git diff --cached --unified=0 -- . ':(exclude)Hot_click_outlet/src/main/resources/static/assets/**' ':(exclude)Hot_click_outlet/src/main/resources/static/sw.js' ':(exclude)Hot_click_outlet/src/main/resources/static/workbox-*.js' | grep -E '^\+[^+]' | grep -E "$PATTERNS" || true)
if [ -n "$SECRETS_FOUND" ]; then
  printf "${RED}[SECRET GUARD] BLOQUEADO: Se detectaron posibles API keys en el diff:${NC}\n"
  echo "$SECRETS_FOUND"
  printf "\nMueve las credenciales al archivo .env y referencialas como variables de entorno.\n\n"
  ERRORS=1
fi

# ─── 3. Bloquear application-local.properties con valores reales ──────────────
LOCAL_PROPS=$(git diff --cached --name-only | grep -E 'application-local\.(properties|yml)$' || true)
if [ -n "$LOCAL_PROPS" ]; then
  printf "${RED}[SECRET GUARD] BLOQUEADO: application-local.properties/yml nunca debe commitearse:${NC}\n"
  echo "$LOCAL_PROPS"
  printf "\n"
  ERRORS=1
fi

# ─── 4. gitleaks (si está instalado) — cobertura amplia + detección de entropía
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --config .gitleaks.toml --redact --verbose; then
    printf "${RED}[SECRET GUARD] BLOQUEADO: gitleaks detectó un posible secreto (ver arriba).${NC}\n\n"
    ERRORS=1
  fi
else
  printf "${YELLOW}[SECRET GUARD] gitleaks no está instalado — solo corrieron los chequeos básicos.${NC}\n"
  printf "${YELLOW}[SECRET GUARD] Instalá gitleaks para cobertura completa: https://github.com/gitleaks/gitleaks#installing${NC}\n"
  printf "${YELLOW}[SECRET GUARD] El gate real de todos modos corre en CI (.github/workflows/security.yml).${NC}\n\n"
fi

# ─── Resultado ────────────────────────────────────────────────────────────────
if [ "$ERRORS" -eq 0 ]; then
  printf "${GREEN}[SECRET GUARD] OK — ningún secreto detectado.${NC}\n"
  exit 0
else
  exit 1
fi
