{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E4 trusted policy (P) v1 — r6.1 (mode)",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "repository",
    "pullNumber",
    "mode",
    "candidateHeadSha",
    "approverActorId",
    "approvalCommentId",
    "verifierCommit",
    "fixture",
    "validity",
    "trustedReusable",
    "caller",
    "gitleaks",
    "corpusManifestSha256",
    "checkRunName",
    "detectorCommit",
    "testsCheckName"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "ACTIVE"
      ]
    },
    "repository": {
      "const": "hotclickdev/Hot-click-dev"
    },
    "pullNumber": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "no-exceptions",
        "live-exception"
      ],
      "description": "obligatorio; solo estos dos valores"
    },
    "candidateHeadSha": {
      "description": "live-exception: valor obligatorio (sha40 / entero >= 1 / objeto fixture); no-exceptions: PRESENTE y null (ausente != null)"
    },
    "approverActorId": {
      "type": "integer",
      "minimum": 1
    },
    "approverLogin": {
      "type": "string",
      "minLength": 1
    },
    "approvalCommentId": {
      "description": "live-exception: valor obligatorio (sha40 / entero >= 1 / objeto fixture); no-exceptions: PRESENTE y null (ausente != null)"
    },
    "verifierCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fixture": {
      "description": "live-exception: valor obligatorio (sha40 / entero >= 1 / objeto fixture); no-exceptions: PRESENTE y null (ausente != null)"
    },
    "validity": {
      "type": "object",
      "required": [
        "kind",
        "pullNumber"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "untilPullMerged"
        },
        "pullNumber": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "trustedReusable": {
      "type": "object",
      "required": [
        "path",
        "sha"
      ],
      "properties": {
        "sha": {
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "caller": {
      "type": "object",
      "required": [
        "path",
        "blob"
      ],
      "properties": {
        "blob": {
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "gitleaks": {
      "type": "object",
      "required": [
        "version",
        "sha256",
        "configSha256"
      ]
    },
    "corpusManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkRunName": {
      "type": "string",
      "minLength": 1
    },
    "detectorCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "testsCheckName": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "no-exceptions"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "candidateHeadSha": {
            "type": "null"
          },
          "approvalCommentId": {
            "type": "null"
          },
          "fixture": {
            "type": "null"
          }
        },
        "required": [
          "candidateHeadSha",
          "approvalCommentId",
          "fixture"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live-exception"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "candidateHeadSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "approvalCommentId": {
            "type": "integer",
            "minimum": 1
          },
          "fixture": {
            "type": "object",
            "required": [
              "path",
              "constant",
              "blob",
              "fingerprint",
              "entryId"
            ],
            "properties": {
              "blob": {
                "pattern": "^[0-9a-f]{40}$"
              },
              "fingerprint": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "entryId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
